{
  "name": "token-goat-mem",
  "version": "0.5.1",
  "description": "Local-first long-term memory for AI coding agents (Claude Code, Copilot, Codex): durable facts with trust levels and anchor-based staleness detection",
  "type": "module",
  "bin": {
    "mem": "dist/token-goat-mem.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DFKHelper/token-goat-mem.git"
  },
  "homepage": "https://github.com/DFKHelper/token-goat-mem#readme",
  "bugs": {
    "url": "https://github.com/DFKHelper/token-goat-mem/issues"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eslint.json",
    "test": "vitest run",
    "test:guards": "vitest run tests/guards",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "eval": "tsx eval/run.ts",
    "lint": "eslint src tests eval",
    "dev": "tsx src/main.ts",
    "arch:check": "node scripts/sync-arch-docs.mjs --check",
    "arch:write": "node scripts/sync-arch-docs.mjs --write",
    "comments:check": "node scripts/single-line-comments.mjs --check",
    "comments:write": "node scripts/single-line-comments.mjs --write",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "copilot",
    "ai",
    "memory",
    "agent-memory",
    "coding-assistant",
    "llm",
    "conversational-memory",
    "context-management",
    "local-first",
    "sqlite"
  ],
  "files": [
    "dist/",
    "scripts/postinstall.mjs",
    "README.md",
    "LICENSE"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
